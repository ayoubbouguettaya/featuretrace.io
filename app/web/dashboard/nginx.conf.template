# Serves the dashboard and proxies /v1 to the FeatureTrace query API.
# ${QUERY_API_URL} is filled in by the nginx image's envsubst at startup.

server {
  listen 80;
  root /usr/share/nginx/html;

  # Re-resolve the query API's name so a restarted container is picked up.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  location /v1/ {
    set $query_api ${QUERY_API_URL};
    proxy_pass $query_api;
    access_log off;
  }

  location / {
    try_files $uri /index.html;
  }
}
